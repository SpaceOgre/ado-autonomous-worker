{
    "Worker": {
        "MaxItemsPerRun": 5,
        "ReviewCycleLimit": 1,
        "DryRun": false,
        "CleanupWorktreesAfterSuccess": false,
        "MaxPromptComments": 8,
        "MaxPromptCommentCharacters": 4000
    },
    "Serilog": {
        "ConsoleLevel": "Warning"
    },
    "AzureDevOps": {
        "OrganizationUrl": "https://dev.azure.com/grutbildning",
        "Project": "PRIIS",
        "Team": "PRIIS Team",
        "DefaultAssignee": "daniel.nordstrom@consid.se",
        "PersonalAccessToken": ""
    },
    "Agents": {
        "Plan": {
            "Provider": "Claude",
            "Model": "sonnet",
            "Effort": "high",
            "CommandPath": "claude",
            "ExtraArguments": [
                "--agent",
                "Plan"
            ]
        },
        "Code": {
            "Provider": "Claude",
            "Model": "sonnet",
            "Effort": "high",
            "CommandPath": "claude"
        },
        "Review": {
            "Provider": "Codex",
            "Model": "gpt-5.4",
            "Effort": "high",
            "CommandPath": "codex"
        },
        "Pr": {
            "Provider": "Claude",
            "Model": "haiku",
            "Effort": "low",
            "CommandPath": "claude"
        }
    },
    "Repositories": {
        "AzureDevOpsRepository": "GR.PRIIS",
        "BaseClonePath": "D:\\GR.PRIIS",
        "MainBranch": "main",
        "WorktreeRoot": "D:\\GR.PRIIS.wt",
        "Backend": {
            "Kind": "Backend",
            "Folder": "backend",
            "ValidationWorkingDirectory": "backend",
            "ValidationCommands": [
                "dotnet build",
                "dotnet test tests/GR.PRIIS.API.UnitTests/GR.PRIIS.API.UnitTests.csproj --no-build",
                "dotnet test tests/GR.PRIIS.Library.UnitTests/GR.PRIIS.Library.UnitTests.csproj --no-build",
                "dotnet test tests/GR.PRIIS.Worker.UnitTests/GR.PRIIS.Worker.UnitTests.csproj --no-build",
                "dotnet test tests/GR.PRIIS.ServiceDefaults.UnitTests/GR.PRIIS.ServiceDefaults.UnitTests.csproj --no-build",
                "dotnet test tests/GR.PRIIS.ArchitectureTests/GR.PRIIS.ArchitectureTests.csproj --no-build",
                "dotnet test tests/GR.PRIIS.API.IntegrationTests/GR.PRIIS.API.IntegrationTests.csproj --no-build"
            ]
        },
        "Frontend": {
            "Kind": "Frontend",
            "Folder": "frontend",
            "ValidationWorkingDirectory": "frontend/source/priis-web",
            "ValidationCommands": [
                "npm ci",
                "npm run build"
            ]
        }
    },
    "Deploy": {
        "PipelineId": 265,
        "Environment": "Test",
        "Branch": "main",
        "PollIntervalSeconds": 30,
        "TimeoutMinutes": 60,
        "ReadyForTestAssignee": ""
    }
}