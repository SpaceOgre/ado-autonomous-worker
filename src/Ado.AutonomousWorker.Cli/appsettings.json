{
    "Worker": {
        "MaxItemsPerRun": 5,
        "ReviewCycleLimit": 1,
        "DryRun": false,
        "CleanupWorktreesAfterSuccess": false,
        "MaxPromptComments": 8,
        "MaxPromptCommentCharacters": 4000
    },
    "AzureDevOps": {
        "OrganizationUrl": "https://dev.azure.com/grutbildning",
        "Project": "PRIIS",
        "Team": "PRIIS Team",
        "DefaultAssignee": "daniel.nordstrom@consid.se",
        "PersonalAccessToken": ""
    },
    "Agents": {
        "Plan": {
            "Provider": "Claude",
            "Model": "sonnet",
            "Effort": "high",
            "CommandPath": "claude",
            "ExtraArguments": [
                "--agent",
                "Plan"
            ]
        },
        "Code": {
            "Provider": "Claude",
            "Model": "sonnet",
            "Effort": "high",
            "CommandPath": "claude"
        },
        "Review": {
            "Provider": "Codex",
            "Model": "gpt-5.4",
            "Effort": "high",
            "CommandPath": "codex"
        },
        "Pr": {
            "Provider": "Claude",
            "Model": "haiku",
            "Effort": "low",
            "CommandPath": "claude"
        }
    },
    "Repositories": {
        "Backend": {
            "Kind": "Backend",
            "Name": "Backend",
            "AzureDevOpsRepository": "GR.PRIIS.Backend",
            "BaseClonePath": "D:\\GR.PRIIS.Workspace\\GR.PRIIS.Backend",
            "RemoteUrl": "",
            "MainBranch": "main",
            "WorktreeRoot": "D:\\GR.PRIIS.Workspace\\worktrees\\backend",
            "ValidationCommands": [
                "dotnet build --no-restore"
            ]
        },
        "Frontend": {
            "Kind": "Frontend",
            "Name": "Frontend",
            "AzureDevOpsRepository": "GR.PRIIS.Frontend",
            "BaseClonePath": "D:\\GR.PRIIS.Workspace\\GR.PRIIS.Frontend",
            "RemoteUrl": "",
            "MainBranch": "main",
            "WorktreeRoot": "D:\\GR.PRIIS.Workspace\\worktrees\\frontend",
            "ValidationWorkingDirectory": "source/priis-web",
            "ValidationCommands": [
                "npm ci",
                "npm run build"
            ]
        }
    }
}