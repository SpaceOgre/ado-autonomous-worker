@page "/deploys/{DeployId}"
@rendermode InteractiveServer
@inject IStateStore StateStore
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Deploy Detail — ADO Autonomous Worker</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_deploy is null)
{
    <MudAlert Severity="Severity.Error">Deploy not found.</MudAlert>
}
else
{
    <MudBreadcrumbs Items="_breadcrumbs" Class="pa-0 mb-2" />

    <MudGrid Class="mb-4">
        <MudItem xs="12" md="8">
            <MudText Typo="Typo.h5">
                @(_deploy.IsTag ? "Tag:" : "Branch:") @_deploy.Ref
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                <span>@(_deploy.DeployId.Length > 8 ? _deploy.DeployId[..8] + "…" : _deploy.DeployId)</span>
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" title="Copy deploy ID" OnClick="@CopyDeployId" />
            </MudText>
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex align-center justify-end gap-2 flex-wrap">
            <MudChip T="string" Color="DashboardColors.ForDeployStatus(_deploy.Status)">@_deploy.Status</MudChip>
            @if (_deploy.Status == DeployStatus.Running)
            {
                <MudChip T="string" Color="DashboardColors.ForDeployPhase(_deploy.Phase)">@_deploy.Phase</MudChip>
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Circle">Live</MudChip>
            }
        </MudItem>
    </MudGrid>

    @if (_deploy.FailureReason is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_deploy.FailureReason</MudAlert>
    }

    <MudGrid Class="mb-4">
        <MudItem xs="6" md="3">
            <MudText Typo="Typo.caption">Started</MudText>
            <MudText>@_deploy.CreatedAt.ToLocalTime().ToString("g")</MudText>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudText Typo="Typo.caption">Duration</MudText>
            <MudText>@FormatDuration()</MudText>
        </MudItem>
        @if (_deploy.BackendPipelineId.HasValue)
        {
            <MudItem xs="6" md="3">
                <MudText Typo="Typo.caption">Backend Pipeline</MudText>
                <MudText>
                    #@_deploy.BackendPipelineId
                    @if (_deploy.BackendRunId.HasValue)
                    {
                        <span> · run #@_deploy.BackendRunId</span>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Inline="true"> · not started</MudText>
                    }
                </MudText>
            </MudItem>
        }
        @if (_deploy.FrontendPipelineId.HasValue)
        {
            <MudItem xs="6" md="3">
                <MudText Typo="Typo.caption">Frontend Pipeline</MudText>
                <MudText>
                    #@_deploy.FrontendPipelineId
                    @if (_deploy.FrontendRunId.HasValue)
                    {
                        <span> · run #@_deploy.FrontendRunId</span>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Inline="true"> · not started</MudText>
                    }
                </MudText>
            </MudItem>
        }
    </MudGrid>

    <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true">
        <MudTabPanel Text="Events" Icon="@Icons.Material.Filled.Timeline" BadgeData="@(_events.Count > 0 ? (object)_events.Count : null)" Class="pt-4">
            @if (_events.Count == 0)
            {
                <MudText Color="Color.Secondary">No events yet.</MudText>
            }
            else
            {
                <MudSimpleTable Dense="true" Hover="true" Style="width:100%">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Delta / Duration</th>
                            <th>Message</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var gi = 0; gi < _groups.Count; gi++)
                        {
                            var group = _groups[gi];
                            var groupIdx = gi;
                            var isExpanded = _expandedGroups.Contains(groupIdx);

                            <tr>
                                <td>@group.First.Timestamp.ToLocalTime().ToString("HH:mm:ss")</td>
                                <td>
                                    @if (group.IsGroup)
                                    {
                                        var duration = group.All[^1].Timestamp - group.First.Timestamp;
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" title="Duration in this state">@DashboardColors.FormatDuration(duration)</MudText>
                                    }
                                    else if (group.PrecedingEvent is not null)
                                    {
                                        var delta = group.First.Timestamp - group.PrecedingEvent.Timestamp;
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">+@DashboardColors.FormatDuration(delta)</MudText>
                                    }
                                </td>
                                <td>
                                    @group.First.Message
                                    @if (group.IsGroup)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ml-2">×@group.All.Count</MudChip>
                                        <MudIconButton Icon="@(isExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                       Size="Size.Small" Class="ml-n1"
                                                       OnClick="@(() => ToggleGroup(groupIdx))" />
                                    }
                                </td>
                            </tr>

                            @if (group.IsGroup && isExpanded)
                            {
                                <tr>
                                    <td colspan="3" style="padding:0 0 4px 2rem; background:transparent">
                                        <MudSimpleTable Dense="true" Style="width:100%">
                                            <tbody>
                                                @for (var ei = 0; ei < group.All.Count; ei++)
                                                {
                                                    var ev = group.All[ei];
                                                    var prev = ei > 0 ? group.All[ei - 1] : null;
                                                    <tr>
                                                        <td style="width:90px">@ev.Timestamp.ToLocalTime().ToString("HH:mm:ss")</td>
                                                        <td style="width:80px">
                                                            @if (prev is not null)
                                                            {
                                                                var d = ev.Timestamp - prev.Timestamp;
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">+@DashboardColors.FormatDuration(d)</MudText>
                                                            }
                                                        </td>
                                                        <td>@ev.Message</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </MudSimpleTable>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudTabPanel>
        <MudTabPanel Text="Changes" Icon="@Icons.Material.Filled.SwapHoriz" BadgeData="@(_changes.Count > 0 ? (object)_changes.Count : null)" Class="pt-4">
            @if (_changes.Count == 0)
            {
                <MudText Color="Color.Secondary">No work item changes recorded.</MudText>
            }
            else
            {
                <MudTable Items="_changes" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Type</MudTh>
                        <MudTh>ID</MudTh>
                        <MudTh>Title</MudTh>
                        <MudTh>From State</MudTh>
                        <MudTh></MudTh>
                        <MudTh>To State</MudTh>
                        <MudTh>Assignee</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Type">
                            <MudChip T="string" Size="Size.Small" Color="DashboardColors.ForWorkItemType(context.WorkItemType)">@context.WorkItemType</MudChip>
                        </MudTd>
                        <MudTd DataLabel="ID">#@context.WorkItemId</MudTd>
                        <MudTd DataLabel="Title">@context.Title</MudTd>
                        <MudTd DataLabel="From State">
                            <MudChip T="string" Size="Size.Small" Style="@DashboardColors.ForWorkItemStateStyle(context.CurrentState)">@context.CurrentState</MudChip>
                        </MudTd>
                        <MudTd><MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /></MudTd>
                        <MudTd DataLabel="To State">
                            <MudChip T="string" Size="Size.Small" Style="@DashboardColors.ForWorkItemStateStyle(context.NewState)">@context.NewState</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Assignee">
                            @if (context.CurrentAssignee != context.NewAssignee)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Inline="true">@context.CurrentAssignee</MudText>
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Class="mx-1 mb-n1" />
                            }
                            <span>@context.NewAssignee</span>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter] public string DeployId { get; set; } = "";

    private sealed record EventGroup(DeployEventRecord First, List<DeployEventRecord> All, DeployEventRecord? PrecedingEvent)
    {
        public bool IsGroup => All.Count > 1;
    }

    private bool _loading = true;
    private DeployRecord? _deploy;
    private List<DeployEventRecord> _events = [];
    private List<DeployWorkItemChange> _changes = [];
    private List<EventGroup> _groups = [];
    private HashSet<int> _expandedGroups = [];
    private List<BreadcrumbItem> _breadcrumbs = [];
    private Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        _loading = false;

        _breadcrumbs =
        [
            new BreadcrumbItem("Deploys", href: "/deploys"),
            new BreadcrumbItem(
                _deploy is not null ? (_deploy.DeployId.Length > 8 ? _deploy.DeployId[..8] + "…" : _deploy.DeployId) : DeployId,
                href: null,
                disabled: true
            ),
        ];

        if (_deploy?.Status == DeployStatus.Running)
            _refreshTimer = new Timer(async _ => await InvokeAsync(RefreshAsync), null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(5));
    }

    private async Task LoadDataAsync()
    {
        _deploy = await StateStore.GetDeployAsync(DeployId, CancellationToken.None);
        _events = (await StateStore.GetDeployEventsAsync(DeployId, CancellationToken.None)).ToList();
        _changes = (await StateStore.GetDeployWorkItemChangesAsync(DeployId, CancellationToken.None)).ToList();
        BuildGroups();
    }

    private void BuildGroups()
    {
        _groups = [];
        var messageToGroupIndex = new Dictionary<string, int>();

        for (var i = 0; i < _events.Count; i++)
        {
            var ev = _events[i];
            if (messageToGroupIndex.TryGetValue(ev.Message, out var idx))
            {
                _groups[idx].All.Add(ev);
            }
            else
            {
                messageToGroupIndex[ev.Message] = _groups.Count;
                _groups.Add(new EventGroup(ev, [ev], i > 0 ? _events[i - 1] : null));
            }
        }
    }

    private void ToggleGroup(int index)
    {
        if (!_expandedGroups.Add(index))
            _expandedGroups.Remove(index);
    }

    private async Task RefreshAsync()
    {
        await LoadDataAsync();
        StateHasChanged();

        if (_deploy?.Status != DeployStatus.Running)
        {
            _refreshTimer?.Dispose();
            _refreshTimer = null;
        }
    }

    private string FormatDuration()
    {
        if (_deploy is null) return "-";
        var end = _deploy.Status == DeployStatus.Running ? DateTimeOffset.UtcNow : _deploy.UpdatedAt;
        return DashboardColors.FormatDuration(end - _deploy.CreatedAt);
    }

    private async Task CopyDeployId()
    {
        if (_deploy is null) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _deploy.DeployId);
    }

    public void Dispose() => _refreshTimer?.Dispose();
}
