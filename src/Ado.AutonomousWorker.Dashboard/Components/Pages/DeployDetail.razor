@page "/deploys/{DeployId}"
@rendermode InteractiveServer
@inject IStateStore StateStore
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Deploy Detail — ADO Autonomous Worker</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_deploy is null)
{
    <MudAlert Severity="Severity.Error">Deploy not found.</MudAlert>
}
else
{
    <MudBreadcrumbs Items="_breadcrumbs" Class="pa-0 mb-2" />

    <MudGrid Class="mb-4">
        <MudItem xs="12" md="8">
            <MudText Typo="Typo.h5">
                @(_deploy.IsTag ? "Tag:" : "Branch:") @_deploy.Ref
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                <span>@(_deploy.DeployId.Length > 8 ? _deploy.DeployId[..8] + "…" : _deploy.DeployId)</span>
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" title="Copy deploy ID" OnClick="@CopyDeployId" />
            </MudText>
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex align-center justify-end gap-2 flex-wrap">
            <MudChip T="string" Color="DashboardColors.ForDeployStatus(_deploy.Status)">@_deploy.Status</MudChip>
            @if (_deploy.Status == DeployStatus.Running)
            {
                <MudChip T="string" Color="DashboardColors.ForDeployPhase(_deploy.Phase)">@_deploy.Phase</MudChip>
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Circle">Live</MudChip>
            }
        </MudItem>
    </MudGrid>

    @if (_deploy.FailureReason is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_deploy.FailureReason</MudAlert>
    }

    <MudGrid Class="mb-4">
        <MudItem xs="6" md="3">
            <MudText Typo="Typo.caption">Started</MudText>
            <MudText>@_deploy.CreatedAt.ToLocalTime().ToString("g")</MudText>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudText Typo="Typo.caption">Duration</MudText>
            <MudText>@FormatDuration()</MudText>
        </MudItem>
        @if (_deploy.BackendPipelineId.HasValue)
        {
            <MudItem xs="6" md="3">
                <MudText Typo="Typo.caption">Backend Pipeline</MudText>
                <MudText>
                    #@_deploy.BackendPipelineId
                    @if (_deploy.BackendRunId.HasValue)
                    {
                        <span> · run #@_deploy.BackendRunId</span>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Inline="true"> · not started</MudText>
                    }
                </MudText>
            </MudItem>
        }
        @if (_deploy.FrontendPipelineId.HasValue)
        {
            <MudItem xs="6" md="3">
                <MudText Typo="Typo.caption">Frontend Pipeline</MudText>
                <MudText>
                    #@_deploy.FrontendPipelineId
                    @if (_deploy.FrontendRunId.HasValue)
                    {
                        <span> · run #@_deploy.FrontendRunId</span>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Inline="true"> · not started</MudText>
                    }
                </MudText>
            </MudItem>
        }
    </MudGrid>

    <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" PanelClass="pt-4">
        <MudTabPanel Text="Events" Icon="@Icons.Material.Filled.Timeline" BadgeData="@(_events.Count > 0 ? (object)_events.Count : null)">
            @if (_events.Count == 0)
            {
                <MudText Color="Color.Secondary">No events yet.</MudText>
            }
            else
            {
                <MudTable Items="_events" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Time</MudTh>
                        <MudTh>Delta</MudTh>
                        <MudTh>Message</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        @{ var idx = _events.IndexOf(context); }
                        <MudTd DataLabel="Time">@context.Timestamp.ToLocalTime().ToString("HH:mm:ss")</MudTd>
                        <MudTd DataLabel="Delta">
                            @if (idx > 0)
                            {
                                var delta = context.Timestamp - _events[idx - 1].Timestamp;
                                <MudText Typo="Typo.caption" Color="Color.Secondary">+@DashboardColors.FormatDuration(delta)</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="Message">@context.Message</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>
        <MudTabPanel Text="Changes" Icon="@Icons.Material.Filled.SwapHoriz" BadgeData="@(_changes.Count > 0 ? (object)_changes.Count : null)">
            @if (_changes.Count == 0)
            {
                <MudText Color="Color.Secondary">No work item changes recorded.</MudText>
            }
            else
            {
                <MudTable Items="_changes" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Type</MudTh>
                        <MudTh>ID</MudTh>
                        <MudTh>Title</MudTh>
                        <MudTh>From State</MudTh>
                        <MudTh></MudTh>
                        <MudTh>To State</MudTh>
                        <MudTh>Assignee</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Type">
                            <MudChip T="string" Size="Size.Small" Color="DashboardColors.ForWorkItemType(context.WorkItemType)">@context.WorkItemType</MudChip>
                        </MudTd>
                        <MudTd DataLabel="ID">#@context.WorkItemId</MudTd>
                        <MudTd DataLabel="Title">@context.Title</MudTd>
                        <MudTd DataLabel="From State">@context.CurrentState</MudTd>
                        <MudTd><MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /></MudTd>
                        <MudTd DataLabel="To State">
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">@context.NewState</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Assignee">
                            @if (context.CurrentAssignee != context.NewAssignee)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Inline="true">@context.CurrentAssignee</MudText>
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Class="mx-1 mb-n1" />
                            }
                            <span>@context.NewAssignee</span>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter] public string DeployId { get; set; } = "";

    private bool _loading = true;
    private DeployRecord? _deploy;
    private List<DeployEventRecord> _events = [];
    private List<DeployWorkItemChange> _changes = [];
    private List<BreadcrumbItem> _breadcrumbs = [];
    private Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        _loading = false;

        _breadcrumbs =
        [
            new BreadcrumbItem("Deploys", href: "/deploys"),
            new BreadcrumbItem(
                _deploy is not null ? (_deploy.DeployId.Length > 8 ? _deploy.DeployId[..8] + "…" : _deploy.DeployId) : DeployId,
                href: null,
                disabled: true
            ),
        ];

        if (_deploy?.Status == DeployStatus.Running)
            _refreshTimer = new Timer(async _ => await InvokeAsync(RefreshAsync), null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(5));
    }

    private async Task LoadDataAsync()
    {
        _deploy = await StateStore.GetDeployAsync(DeployId, CancellationToken.None);
        _events = (await StateStore.GetDeployEventsAsync(DeployId, CancellationToken.None)).ToList();
        _changes = (await StateStore.GetDeployWorkItemChangesAsync(DeployId, CancellationToken.None)).ToList();
    }

    private async Task RefreshAsync()
    {
        await LoadDataAsync();
        StateHasChanged();

        if (_deploy?.Status != DeployStatus.Running)
        {
            _refreshTimer?.Dispose();
            _refreshTimer = null;
        }
    }

    private string FormatDuration()
    {
        if (_deploy is null) return "-";
        var end = _deploy.Status == DeployStatus.Running ? DateTimeOffset.UtcNow : _deploy.UpdatedAt;
        return DashboardColors.FormatDuration(end - _deploy.CreatedAt);
    }

    private async Task CopyDeployId()
    {
        if (_deploy is null) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _deploy.DeployId);
    }

    public void Dispose() => _refreshTimer?.Dispose();
}
