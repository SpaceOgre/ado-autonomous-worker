@page "/executions"
@rendermode InteractiveServer
@inject IStateStore StateStore
@inject IOptions<AzureDevOpsOptions> AdoOptions
@implements IDisposable

<PageTitle>Executions — ADO Autonomous Worker</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">All Executions</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudStack Row="true" Spacing="1" Class="mb-3 flex-wrap">
        @foreach (var status in _statusFilters)
        {
            var isActive = _activeStatusFilter == status;
            <MudChip T="string"
                     Color="@(isActive ? DashboardColors.ForStatus(status == "All" ? ExecutionStatus.Running : Enum.Parse<ExecutionStatus>(status)) : Color.Default)"
                     Variant="@(isActive ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => SetStatusFilter(status))"
                     Size="Size.Small">
                @status (@CountForFilter(status))
            </MudChip>
        }
    </MudStack>

    <MudTable Items="_filtered" Hover="true" Dense="true" Filter="TextFilterFunc">
        <ToolBarContent>
            <MudSpacer />
            <MudTextField @bind-Value="_searchText" Placeholder="Search..." Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<TaskExecutionRecord,object>(x=>x.WorkItemId)">Work Item</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<TaskExecutionRecord,object>(x=>x.Title)">Title</MudTableSortLabel></MudTh>
            <MudTh>Kind</MudTh>
            <MudTh>Phase</MudTh>
            <MudTh>Status</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<TaskExecutionRecord,object>(x=>x.UpdatedAt)" InitialDirection="SortDirection.Descending">Updated</MudTableSortLabel></MudTh>
            <MudTh>PR</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Work Item">
                @{ var wiUrl = AdoOptions.Value.WorkItemUrl(context.WorkItemId); }
                @if (wiUrl is not null)
                {
                    <MudLink Href="@wiUrl" Target="_blank">@context.WorkItemId</MudLink>
                }
                else
                {
                    <span>@context.WorkItemId</span>
                }
            </MudTd>
            <MudTd DataLabel="Title">@context.Title</MudTd>
            <MudTd DataLabel="Kind"><MudChip T="string" Size="Size.Small" Color="DashboardColors.ForKind(context.Kind)">@DashboardColors.FormatKind(context.Kind)</MudChip></MudTd>
            <MudTd DataLabel="Phase"><MudChip T="string" Size="Size.Small" Color="DashboardColors.ForPhase(context.Phase)">@context.Phase</MudChip></MudTd>
            <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="DashboardColors.ForStatus(context.Status)">@context.Status</MudChip></MudTd>
            <MudTd DataLabel="Updated">@context.UpdatedAt.ToLocalTime().ToString("g")</MudTd>
            <MudTd DataLabel="PR">
                @if (context.PullRequests is { Count: > 0 })
                {
                    @foreach (var pr in context.PullRequests)
                    {
                        var prUrl = AdoOptions.Value.PullRequestUrl(pr.RepositoryName, pr.PullRequestId);
                        @if (prUrl is not null)
                        {
                            <MudLink Href="@prUrl" Target="_blank" Class="mr-1">!@pr.PullRequestId</MudLink>
                        }
                        else
                        {
                            <span class="mr-1">!@pr.PullRequestId</span>
                        }
                    }
                }
                else
                {
                    <span>-</span>
                }
            </MudTd>
            <MudTd><MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Href="@($"executions/{context.ExecutionId}")" /></MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No executions found.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private static readonly string[] _statusFilters = ["All", "Running", "Completed", "Failed", "Skipped"];

    private bool _loading = true;
    private List<TaskExecutionRecord> _executions = [];
    private List<TaskExecutionRecord> _filtered = [];
    private string _searchText = string.Empty;
    private string _activeStatusFilter = "All";
    private System.Threading.Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await StateStore.InitializeAsync(CancellationToken.None);
        await LoadDataAsync();
        _refreshTimer = new System.Threading.Timer(_ => InvokeAsync(async () =>
        {
            await LoadDataAsync();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private async Task LoadDataAsync()
    {
        var all = await StateStore.ListExecutionsAsync(CancellationToken.None);
        _executions = all.OrderByDescending(e => e.UpdatedAt).ToList();
        ApplyStatusFilter();
        _loading = false;
    }

    private void SetStatusFilter(string filter)
    {
        _activeStatusFilter = filter;
        ApplyStatusFilter();
    }

    private void ApplyStatusFilter()
    {
        _filtered = _activeStatusFilter == "All"
            ? _executions
            : _executions.Where(e => e.Status.ToString() == _activeStatusFilter).ToList();
    }

    private bool TextFilterFunc(TaskExecutionRecord record)
    {
        if (string.IsNullOrWhiteSpace(_searchText)) return true;
        return record.Title.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            || record.WorkItemId.ToString().Contains(_searchText)
            || record.Status.ToString().Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            || record.Phase.ToString().Contains(_searchText, StringComparison.OrdinalIgnoreCase);
    }

    private int CountForFilter(string filter) =>
        filter == "All"
            ? _executions.Count
            : _executions.Count(e => e.Status.ToString() == filter);

    public void Dispose() => _refreshTimer?.Dispose();
}
